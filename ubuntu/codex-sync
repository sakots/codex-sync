#!/usr/bin/env bash
set -euo pipefail

REPO="$HOME/dev/codex-history"
LOCAL_DIRS=("$HOME/.codex/sessions")
REPO_DIRS=("sessions")
if [ -d "$HOME/.omp/agent" ]; then
  LOCAL_DIRS+=("$HOME/.omp/agent/sessions")
  REPO_DIRS+=("omp/sessions")
fi

echo "== Session sync =="

if [ ! -d "$REPO/.git" ]; then
  echo "ERROR: Git repository not found:"
  echo "  $REPO"
  exit 1
fi

for i in "${!LOCAL_DIRS[@]}"; do
  mkdir -p "${LOCAL_DIRS[$i]}" "$REPO/${REPO_DIRS[$i]}"
done

cd "$REPO"

echo
echo "[1/5] Pulling remote changes..."
git pull --rebase

echo
echo "[2/5] Importing remote sessions..."
for i in "${!LOCAL_DIRS[@]}"; do
  rsync -a "$REPO/${REPO_DIRS[$i]}/" "${LOCAL_DIRS[$i]}/"
done

echo
echo "[3/5] Exporting local sessions into repository..."
for i in "${!LOCAL_DIRS[@]}"; do
  rsync -a "${LOCAL_DIRS[$i]}/" "$REPO/${REPO_DIRS[$i]}/"
done

echo
echo "[4/5] Checking Git changes..."

git add -- "${REPO_DIRS[@]}"

if git diff --cached --quiet; then
  echo "No new sessions."
else
  HOST="$(hostname)"
  DATE="$(date '+%Y-%m-%d %H:%M:%S')"

  git commit -m "Sync sessions from $HOST at $DATE"

  echo
  echo "[5/5] Pushing..."
  git push
fi

echo
echo "Sessions synced."
